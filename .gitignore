# Local autonomous initiatives and their nested research projects
/initiatives/

# Local lab coordination state
/lab/

# Legacy local research state retained during migration
/projects/
/programs/*/

# Internal development and evaluation records belong in the private sibling workspace
/development/
/evaluations/
/test-runs/
/tmp/

# Local cloned repositories and generated optimization runs
/benchmark-lab/

# Experimental skill prototypes and evaluation artifacts
/skill-lab/

# Local machine and environment state
.DS_Store
.env
.env.*
!.env.example
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.log

# Model and array artifacts do not belong in the released harness
*.safetensors
*.ckpt
*.pt
*.pth
*.npy
*.npz
